{
  "name": "inksign-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @inksign/core && npm run build -w @inksign/pdf && npm run build -w @inksign/ui && npm run build -w @inksign/react",
    "dev": "npm run dev --workspaces --if-present",
    "clean": "rimraf packages/*/dist packages/*/.tsbuildinfo",
    "typecheck": "npm run build && tsc --build tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "size": "size-limit",
    "release": "npm run build && changeset publish",
    "version": "changeset version && npm install --package-lock-only",
    "smoke": "node scripts/smoke.mjs",
    "typecheck:only": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@changesets/cli": "^2.29.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "rimraf": "^6.0.1",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
