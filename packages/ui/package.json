{
  "name": "@inksign/ui",
  "version": "0.2.0",
  "description": "Framework-agnostic UI for InkSign: variable-width signature capture, document layout and virtualization, white-label theming, accessibility helpers and web components.",
  "license": "MIT",
  "author": "harshwhql",
  "homepage": "https://github.com/harshwhql/inksign#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshwhql/inksign.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/harshwhql/inksign/issues",
  "keywords": [
    "signature-pad",
    "signature-canvas",
    "electronic-signature",
    "esignature",
    "web-components",
    "custom-elements",
    "theming",
    "white-label",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@inksign/core": "0.2.0",
    "@inksign/pdf": "0.2.0"
  }
}
